import can
import time

# --- 配置 ---
VECTOR_APP_NAME = 'MyPythonCAN'  # 改成你在 Vector Hardware Config 里创建的应用名
CHANNEL_TX = 0                   # 对应 VN1630A 的 CH1
CHANNEL_RX = 1                   # 对应 VN1630A 的 CH2
BITRATE = 500000                 # 波特率 500 kbps
CAN_ID = 0x123                   # 要发送的 CAN ID
DATA = [0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88] # 要发送的 8 字节数据
# -------------

def main():
    print(f"正在尝试连接 Vector 设备，应用名: '{VECTOR_APP_NAME}'...")

    # 创建两个总线实例，分别负责发送和接收
    try:
        bus_tx = can.interface.Bus(interface='vector', channel=CHANNEL_TX, bitrate=BITRATE, app_name=VECTOR_APP_NAME)
        print(f"发送通道 (CH{CHANNEL_TX + 1}) 初始化成功。")

        bus_rx = can.interface.Bus(interface='vector', channel=CHANNEL_RX, bitrate=BITRATE, app_name=VECTOR_APP_NAME)
        print(f"接收通道 (CH{CHANNEL_RX + 1}) 初始化成功。")

    except can.CanError as e:
        print(f"CAN 总线初始化失败！请检查:\n- 应用名 '{VECTOR_APP_NAME}' 是否正确配置\n- VN1630A 是否被其他程序占用")
        print(f"错误详情: {e}")
        return

    # 构造要发送的 CAN 报文
    msg_to_send = can.Message(arbitration_id=CAN_ID, data=DATA, is_extended_id=False)
    print(f"\n准备在 CH{CHANNEL_TX + 1} 上发送报文: {msg_to_send}")

    try:
        # 发送报文
        bus_tx.send(msg_to_send)
        print("报文已发送，等待接收...")

        # 等待一小会儿，确保硬件有时间处理
        time.sleep(0.01)

        # 尝试从接收通道读取报文，设置 2 秒超时
        received_msg = bus_rx.recv(timeout=2.0)

        # 检查接收结果
        if received_msg is not None:
            print(f"\n成功！在 CH{CHANNEL_RX + 1} 上收到报文: {received_msg}")
            if received_msg.arbitration_id == CAN_ID and received_msg.data == DATA:
                print("自发自收测试通过！报文内容完全一致。")
            else:
                print("注意：收到报文，但内容与发送的不符。")
        else:
            print("\n接收超时，未收到任何报文。")
            print("请检查:")
            print("  1. CH1 的 CAN_H 是否连接到 CH2 的 CAN_H")
            print("  2. 总线两端是否已正确连接 120 欧姆的终端电阻")

    except can.CanError as e:
        print(f"CAN 通信过程中发生错误: {e}")
    finally:
        # 无论如何，最后都要关闭总线连接
        bus_tx.shutdown()
        bus_rx.shutdown()
        print("\n总线连接已关闭。")

if __name__ == "__main__":
    main()